{
  "common": {
    "image_size": 224,
    "batch_size": 32,
    "seed": 42,
    "monitor": "val_loss",
    "early_stopping_patience": 8,
    "reduce_lr_patience": 3,
    "reduce_lr_factor": 0.3,
    "min_lr": 1e-6
  },
  "augmentation": {
    "flip": "horizontal_and_vertical",
    "rotation": 0.1,
    "zoom": 0.15,
    "brightness": 0.15,
    "contrast": 0.15
  },
  "models": {
    "simple_cnn": {
      "learning_rate": 0.001,
      "epochs": 40,
      "build": {"dropout": 0.5}
    },
    "multitask_cnn": {
      "learning_rate": 0.001,
      "epochs": 40,
      "loss_weights": {"fruit": 1.0, "freshness": 1.0},
      "build": {"dropout": 0.3}
    },
    "transfer": {
      "loss_weights": {"fruit": 1.0, "freshness": 1.0},
      "build": {"backbone": "mobilenet_v2", "dropout": 0.3},
      "stage1": {"learning_rate": 0.001, "epochs": 12},
      "stage2": {"learning_rate": 0.0001, "epochs": 25, "fine_tune_from": "block_13_expand"}
    }
  }
}
